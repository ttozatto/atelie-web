# Lido pelo docker compose (este arquivo vira .env na raiz deste repositorio).

# --- banco ---
POSTGRES_DB=atelie
POSTGRES_USER=atelie
POSTGRES_PASSWORD=atelie

# --- api ---
DATABASE_URL=postgresql+psycopg://atelie:atelie@db:5432/atelie
# Inclua a origem de onde o navegador abre a interface. Se acessar a VM por outra
# maquina, acrescente o IP dela, ex.: http://localhost:3000,http://192.168.0.2:3000
CORS_ORIGINS=http://localhost:3000
# Placeholder de MVP academico (header X-Admin-Token). NAO e autenticacao.
ADMIN_TOKEN=troque-este-token

# --- web ---
# Codigo de servidor do Next fala com a API pela rede interna do Docker.
API_INTERNAL_URL=http://api:8000
# Codigo de navegador fala com a porta publicada no host. E o endereco da API visto
# pelo NAVEGADOR: se voce abre a interface de outra maquina (ex.: http://192.168.0.2:3000),
# use o IP da VM aqui (http://192.168.0.2:8000) — "localhost" seria a sua propria maquina.
NEXT_PUBLIC_API_URL=http://localhost:8000
